# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GLM (Zhipu)
GLM_API_KEY=xxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Kimi (Moonshot)
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Gemini
GEMINI_API_KEY=xxx

# AgentService phase 1 (ReAct loop). Temperatures are placeholders — not
# yet forwarded to adapters until phase 2 wires temperature through.
AGENT_MAX_STEPS=8
AGENT_STEP_TEMPERATURE=0.7
AGENT_FINAL_TEMPERATURE=0.4

# Database (optional, defaults to sqlite:///./workbench.db)
DATABASE_URL=sqlite+aiosqlite:///./workbench.db

# AgentService phase 2b-i (RAG + knowledge base). Embedding uses local
# sentence-transformers + bge-small-zh-v1.5; if torch/the model is not
# installed, EmbeddingService falls back to FakeEmbedder (RAG no-op: uploads
# return 503, retrieve returns []). chroma_persist_dir is resolved against
# the backend root, not CWD.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHROMA_PERSIST_DIR=.chroma
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
KB_TOP_K=4
KB_MIN_SCORE=0.3

