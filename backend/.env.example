# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GLM (Zhipu)
GLM_API_KEY=xxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Kimi (Moonshot)
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Gemini
GEMINI_API_KEY=xxx

# AgentService phase 1 (ReAct loop). Temperatures are placeholders — not
# yet forwarded to adapters until phase 2 wires temperature through.
AGENT_MAX_STEPS=8
AGENT_STEP_TEMPERATURE=0.7
AGENT_FINAL_TEMPERATURE=0.4

# Database (optional, defaults to sqlite:///./workbench.db)
DATABASE_URL=sqlite+aiosqlite:///./workbench.db
